{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "C++ Launch",
        "type": "cppdbg",
        "request": "launch",
        //"preLaunchTask": "CMake Build",
        "program": "/home/dh/labLinux/lab4/mycp",
        "cwd": "${workspaceFolder}",
        "targetArchitecture": "x64",
        "args": [
          "-r",
          "/home/dh/labLinux/test",
          "/home/dh/labLinux/lab4"
        ],
        "stopAtEntry": true,
        "setupCommands": [
          {
            "description": "为 gdb 启用整齐打印",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ],
        "linux": {
          "MIMode": "gdb",
          "miDebuggerPath": "/usr/bin/gdb"
        }
      }
    ]
  }